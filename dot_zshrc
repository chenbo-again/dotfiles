# Write text to the local clipboard, using OSC 52 when running over SSH.
_zle_write_text_to_clipboard() {
  emulate -L zsh
  local _text=$1 _encoded

  if [[ -n ${SSH_CONNECTION-} || -n ${SSH_TTY-} ]] && (( $+commands[base64] )); then
    _encoded=$(printf '%s' "$_text" | base64) || return 1
    _encoded=${_encoded//$'\n'/}
    _encoded=${_encoded//$'\r'/}
    printf '\e]52;c;%s\a' "$_encoded" > /dev/tty
  elif [[ -n ${WAYLAND_DISPLAY-} ]] && (( $+commands[wl-copy] )); then
    printf '%s' "$_text" | wl-copy
  elif [[ -n ${DISPLAY-} ]] && (( $+commands[xclip] )); then
    printf '%s' "$_text" | xclip -selection clipboard
  elif [[ -n ${DISPLAY-} ]] && (( $+commands[xsel] )); then
    printf '%s' "$_text" | xsel --clipboard --input
  else
    return 1
  fi
}

# Copy or cut the active zsh-shift-select region.
_zle_copy_region_to_clipboard() {
  emulate -L zsh
  if (( REGION_ACTIVE )); then
    local _start _end
    if (( CURSOR < MARK )); then _start=$CURSOR; _end=$MARK
    else _start=$MARK; _end=$CURSOR; fi
    if _zle_write_text_to_clipboard "${BUFFER[_start+1,_end]}"; then
      zle deactivate-region -w
    else
      zle -M 'Clipboard unavailable (OSC 52/base64 or a local clipboard tool is required)'
    fi
  fi
}

_zle_cut_region_to_clipboard() {
  emulate -L zsh
  if (( REGION_ACTIVE )); then
    local _start _end
    if (( CURSOR < MARK )); then _start=$CURSOR; _end=$MARK
    else _start=$MARK; _end=$CURSOR; fi
    if _zle_write_text_to_clipboard "${BUFFER[_start+1,_end]}"; then
      zle kill-region -w
    else
      zle -M 'Clipboard unavailable (OSC 52/base64 or a local clipboard tool is required)'
    fi
  fi
}

zle -N _zle_copy_region_to_clipboard
zle -N _zle_cut_region_to_clipboard
bindkey '^[[99;6u' _zle_copy_region_to_clipboard
bindkey '^[[27;6;99~' _zle_copy_region_to_clipboard
bindkey -M shift-select '^[[99;6u' _zle_copy_region_to_clipboard
bindkey -M shift-select '^[[27;6;99~' _zle_copy_region_to_clipboard
bindkey '^[[120;6u' _zle_cut_region_to_clipboard
bindkey '^[[27;6;120~' _zle_cut_region_to_clipboard
bindkey -M shift-select '^[[120;6u' _zle_cut_region_to_clipboard
bindkey -M shift-select '^[[27;6;120~' _zle_cut_region_to_clipboard

