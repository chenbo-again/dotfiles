# Start Yazi and follow its final directory when it exits with q.
function y() {
  local tmp="$(mktemp -t 'yazi-cwd.XXXXXX')" cwd status
  command yazi "$@" --cwd-file="$tmp"
  status=$?
  IFS= read -r -d '' cwd < "$tmp"
  [[ -n "$cwd" && "$cwd" != "$PWD" && -d "$cwd" ]] && builtin cd -- "$cwd"
  command rm -f -- "$tmp"
  return $status
}

