{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-worktree",
    "opencode-pty",
    "openrtk",
    "@mohak34/opencode-notifier@0.2.8",
    "@tarquinen/opencode-dcp@latest",
    // ["@vectorize-io/opencode-hindsight", {
    //   "hindsightApiUrl": "http://{{ if .master }}172.25.23.205{{ else }}127.0.0.1{{ end }}:8888",
    //   "bankId": "{{ if .master }}liushengbo{{ else }}slave{{ end }}",
    //   "autoRecall": true,
    //   "autoRetain": true,
    //   "recallBudget": "mid"
    // }]
  ],
  "permission": {
    "skill": {
      "*": "allow",
      "grill-me": "deny"
    }
  },
  "mcp": {
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "tavily": {
      "type": "local",
      "command": [
        "node",
        "{env:HOME}/.config/opencode/bin/tavily-mcp.bundle.js"
      ],
      "environment": {
        "TAVILY_KEYS_FILE": "{env:HOME}/.config/opencode/secrets/tavily-keys.json"
      },
      "enabled": true,
      "timeout": 960000
    },
    "playwright": {
      "type": "remote",
      "url": "http://127.0.0.1:43102/mcp",
      "oauth": false,
      "enabled": true,
      "timeout": 60000
    },
    // "atlassian": {
    //   "type": "remote",
    //   "url": "http://{{ if .master }}172.25.23.205{{ else }}127.0.0.1{{ end }}:43103/mcp",
    //   "oauth": false,
    //   "enabled": true,
    //   "timeout": 60000
    // },
    // "gerrit": {
    //   "type": "remote",
    //   "url": "http://{{ if .master }}172.25.23.205{{ else }}127.0.0.1{{ end }}:43104/mcp",
    //   "oauth": false,
    //   "enabled": true,
    //   "timeout": 60000
    // }
  },
  "compaction": {
    "auto": true,
    "prune": true
  }
}
