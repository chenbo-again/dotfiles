{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-worktree",
    "opencode-pty",
    "openrtk",
    "opencode-zellij-namer",
    "@mohak34/opencode-notifier@0.2.8",
    "@tarquinen/opencode-dcp@latest",
    ["@vectorize-io/opencode-hindsight", {
      "hindsightApiUrl": "http://172.25.23.205:8888",
      "bankId": "{{ .chezmoi.username }}",
      "autoRecall": true,
      "autoRetain": true,
      "recallBudget": "mid"
    }]
  ],
  "permission": {
    "skill": {
      "*": "allow",
      "grill-me": "deny"
    }
  },
  "mcp": {
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "tavily": {
      "type": "local",
      "command": [
        "/bin/bash",
        "-c",
        "exec \"$HOME/.config/opencode/bin/tavily-mcp-stdio\""
      ],
      "enabled": true,
      "timeout": 960000
    },
    "playwright": {
      "type": "remote",
      "url": "http://127.0.0.1:43102/mcp",
      "headers": {
        "X-API-Key": "{file:~/.config/opencode/mcp-gateway.key}"
      },
      "oauth": false,
      "enabled": true,
      "timeout": 60000
    },
    "jira": {
      "type": "local",
      "command": [
        "/bin/bash",
        "-c",
        "exec \"$HOME/.config/opencode/bin/jira-mcp-stdio\""
      ],
      "enabled": true,
      "timeout": 30000
    },
    "confluence": {
      "type": "local",
      "command": [
        "/bin/bash",
        "-c",
        "exec \"$HOME/.config/opencode/bin/confluence-mcp-stdio\""
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  }
}
