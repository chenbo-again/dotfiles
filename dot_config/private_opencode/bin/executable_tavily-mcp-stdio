#!/usr/bin/env bash
set -Eeuo pipefail
export PATH="$HOME/.local/bin:$PATH"

keys_file="$HOME/.config/opencode/secrets/tavily-keys.json"
key_file="$HOME/.config/opencode/secrets/tavily-api.key"
if [[ -s $keys_file ]]; then
  export TAVILY_KEYS_FILE=$keys_file
elif [[ -s $key_file ]]; then
  TAVILY_API_KEY=$(<"$key_file")
  export TAVILY_API_KEY
fi

proxy_file="$HOME/.config/opencode/mcp-proxy-url"
if [[ -n ${MCP_SETUP_PROXY_URL:-} ]]; then
  proxy_url=$MCP_SETUP_PROXY_URL
elif [[ -s $proxy_file ]]; then
  proxy_url=$(<"$proxy_file")
else
  proxy_url="http://127.0.0.1:7899/"
fi
export http_proxy=$proxy_url https_proxy=$proxy_url
export HTTP_PROXY=$proxy_url HTTPS_PROXY=$proxy_url

exec "node" "$HOME/.config/opencode/bin/tavily-mcp.bundle.js"
